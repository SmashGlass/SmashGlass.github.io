---
/**
 * The Refraction scene: one white beam enters a rotating prism and leaves as
 * four spectrum rays, one per service line. Pointer position drives the light
 * source. Canvas 2D so it costs nothing and needs no WebGL fallback.
 *
 * `mark` renders the compact wordmark variant (no labels, no background).
 */
interface Props { mark?: boolean; class?: string; label?: string }
const { mark = false, class: cls = '', label } = Astro.props;
---

<canvas
  class={`prism-canvas ${cls}`}
  data-mark={mark ? 'true' : 'false'}
  aria-label={label}
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
></canvas>

<style>
  .prism-canvas { display: block; width: 100%; height: 100%; }
</style>

<script>
  const COLORS = ['#4F7DFF', '#22D3A5', '#FFB020', '#FF5C7A'];
  const LABELS = ['AGENTS', 'AUTOMATION', 'INTEGRATIONS', 'MODERNIZATION'];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);

  function start(cv: HTMLCanvasElement) {
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    const mark = cv.dataset.mark === 'true';
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0, py = 0.5, tpy = 0.5, rot = 0, t = 0;

    const size = () => {
      const r = cv.getBoundingClientRect();
      cv.width = Math.max(1, Math.round(r.width * dpr));
      cv.height = Math.max(1, Math.round(r.height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      w = r.width; h = r.height;
    };
    size();
    window.addEventListener('resize', size);

    const host = cv.parentElement;
    if (!mark && host) {
      host.addEventListener('pointermove', (e) => {
        const r = cv.getBoundingClientRect();
        tpy = clamp((e.clientY - r.top) / r.height, 0.18, 0.82);
      });
      host.addEventListener('pointerleave', () => { tpy = 0.5; });
    }

    const tri = (cx: number, cy: number, rad: number, a: number) => {
      ctx.beginPath();
      for (let i = 0; i < 3; i++) {
        const ang = a + (i * Math.PI * 2) / 3 - Math.PI / 2;
        const x = cx + Math.cos(ang) * rad;
        const y = cy + Math.sin(ang) * rad * 1.06;
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.closePath();
    };

    function draw() {
      if (!w || !h) return;
      py += (tpy - py) * 0.07;
      ctx.clearRect(0, 0, w, h);

      if (!mark) {
        const bg = ctx.createRadialGradient(w * 0.56, h * 0.5, 0, w * 0.56, h * 0.5, w * 0.7);
        bg.addColorStop(0, '#0F1219');
        bg.addColorStop(1, '#07080B');
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, w, h);
      }

      const cx = mark ? w * 0.5 : w * 0.42;
      const cy = h * 0.5;
      const rad = Math.min(w, h) * (mark ? 0.34 : 0.21);
      const sx = mark ? -w : -w * 0.08;
      const sy = h * py;
      const ang0 = Math.atan2(cy - sy, cx - sx);

      ctx.globalCompositeOperation = 'lighter';

      if (!mark) {
        for (let p = 0; p < 3; p++) {
          ctx.beginPath();
          ctx.moveTo(sx, sy);
          ctx.lineTo(cx, cy);
          ctx.strokeStyle = `rgba(226,232,240,${0.05 + p * 0.05})`;
          ctx.lineWidth = 9 - p * 3;
          ctx.stroke();
        }
      }

      for (let i = 0; i < 4; i++) {
        const spread = (i - 1.5) * (mark ? 0.22 : 0.125) + Math.sin(t * 0.55 + i) * 0.005;
        const a = ang0 + spread;
        const len = mark ? w * 0.55 : w;
        const ex = cx + Math.cos(a) * len;
        const ey = cy + Math.sin(a) * len;
        const g = ctx.createLinearGradient(cx, cy, ex, ey);
        g.addColorStop(0, COLORS[i]);
        g.addColorStop(0.5, COLORS[i] + '55');
        g.addColorStop(1, COLORS[i] + '00');
        for (let q = 0; q < 2; q++) {
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(ex, ey);
          ctx.strokeStyle = g;
          ctx.globalAlpha = q === 0 ? 0.28 : 0.85;
          ctx.lineWidth = q === 0 ? (mark ? 4 : 11) : mark ? 1 : 1.6;
          ctx.stroke();
        }
        ctx.globalAlpha = 1;

        if (!mark) {
          const lx = cx + Math.cos(a) * (w * 0.42);
          const ly = cy + Math.sin(a) * (w * 0.42);
          if (ly > 14 && ly < h - 10) {
            ctx.globalCompositeOperation = 'source-over';
            ctx.font = "500 9px 'JetBrains Mono', monospace";
            ctx.fillStyle = COLORS[i] + 'DD';
            ctx.textAlign = 'right';
            ctx.fillText(LABELS[i], Math.min(lx, w - 16), ly + 3);
            ctx.globalCompositeOperation = 'lighter';
          }
        }
      }

      ctx.globalCompositeOperation = 'source-over';

      rot += reduce ? 0 : 0.0022;
      tri(cx, cy, rad, rot);
      const pg = ctx.createLinearGradient(cx - rad, cy - rad, cx + rad, cy + rad);
      pg.addColorStop(0, 'rgba(160,190,230,0.18)');
      pg.addColorStop(0.5, 'rgba(120,150,200,0.06)');
      pg.addColorStop(1, 'rgba(200,220,255,0.20)');
      ctx.fillStyle = pg;
      ctx.fill();
      ctx.strokeStyle = 'rgba(205,225,255,0.55)';
      ctx.lineWidth = mark ? 1.4 : 1.1;
      ctx.stroke();

      if (!mark) {
        tri(cx, cy, rad * 0.55, -rot * 1.5);
        ctx.strokeStyle = 'rgba(205,225,255,0.16)';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }
      t += 0.016;
    }

    const visible = () => {
      const r = cv.getBoundingClientRect();
      return r.bottom > -150 && r.top < window.innerHeight + 150;
    };
    const loop = () => { if (visible()) draw(); requestAnimationFrame(loop); };

    if (reduce) setTimeout(draw, 60);
    else loop();
  }

  document.querySelectorAll<HTMLCanvasElement>('.prism-canvas').forEach(start);
</script>
