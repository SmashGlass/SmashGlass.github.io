---
const creds = [
  ['Senior-led engineering', 'Architecture and delivery, not account management'],
  ['AI agents in production', 'Built and deployed, not prototyped'],
  ['Integration and modernization', 'Systems that have to keep running while they change'],
  ['Fixed-price from $1,500', 'Scoped up front, no open-ended retainers'],
];
---
<div class="strip section-rule">
  <div class="wrap strip-in">
    {creds.map(([v, l]) => (
      <div class="cred"><span class="v">{v}</span><span class="l">{l}</span></div>
    ))}
  </div>
</div>

<style>
  .strip { padding: 26px 0; }
  .strip-in { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 22px; }
  .cred { display: flex; flex-direction: column; gap: 5px; }
  .cred .v { font-family: var(--font-display); font-size: 0.9rem; font-weight: 500; color: var(--color-bone); }
  .cred .l { font-size: 0.76rem; color: var(--color-mute-2); line-height: 1.45; }
</style>
