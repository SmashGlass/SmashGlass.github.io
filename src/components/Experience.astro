---
import { DOMAINS, AGENT_TYPES } from '../data/scenarios';
---
<section id="work-done" class="section-rule">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Experience</p>
      <h2>Where we've shipped.</h2>
      <p>
        Deliberately narrow. These are the domains we know well enough to answer straight in the
        first conversation.
      </p>
    </div>

    <div class="domains">
      {DOMAINS.map((d) => (
        <article class="dom" style={`--c: var(--color-${d.color})`}>
          <div class="dom-head">
            <span class="n">{d.n}</span>
            <h3>{d.title}</h3>
          </div>
          <p class="sum">{d.summary}</p>
          <ul class="tags">
            {d.work.map((w) => <li>{w}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="agents">
      <div class="agents-head">
        <span class="lbl">Agents we build</span>
        <p>Most engagements start here.</p>
      </div>
      <div class="agent-grid">
        {AGENT_TYPES.map((a) => (
          <div class="agent">
            <h4>{a.title}</h4>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="owns">
      <span class="lbl">What you own at the end</span>
      <p>
        Source, tests, documentation, and deployment. No proprietary runtime, no retainer
        required to keep it running.
      </p>
    </div>
  </div>
</section>

<style>
  .domains {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: var(--color-rule); border: 1px solid var(--color-rule);
    border-radius: 5px; overflow: hidden;
  }
  @media (max-width: 760px) { .domains { grid-template-columns: 1fr; } }

  .dom {
    background: var(--color-ink-2); padding: 28px 26px;
    display: flex; flex-direction: column; gap: 13px; transition: background .22s;
  }
  .dom:hover { background: var(--color-graphite); }

  .dom-head { display: flex; align-items: baseline; gap: 12px; }
  .dom-head .n {
    font-family: var(--font-mono); font-size: 0.62rem;
    letter-spacing: 0.14em; color: var(--c);
  }
  .dom-head h3 { font-size: 1.08rem; letter-spacing: -0.02em; }

  .sum { font-size: 0.89rem; color: var(--color-mute); line-height: 1.6; }

  .tags {
    display: flex; flex-wrap: wrap; gap: 6px;
    list-style: none; padding: 0; margin: 4px 0 0;
  }
  .tags li {
    font-family: var(--font-mono); font-size: 0.63rem; letter-spacing: 0.04em;
    color: var(--color-mute-2); border: 1px solid var(--color-rule-2);
    border-radius: 2px; padding: 4px 8px;
  }

  .agents { margin-top: 44px; padding-top: 34px; border-top: 1px solid var(--color-rule); }
  .agents-head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 26px; max-width: 58ch; }
  .agents-head .lbl {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-agents);
  }
  .agents-head p { font-size: 0.95rem; color: var(--color-mute); line-height: 1.6; }

  .agent-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 24px 30px;
  }
  @media (max-width: 900px) { .agent-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) { .agent-grid { grid-template-columns: 1fr; gap: 20px; } }

  .agent {
    display: flex; flex-direction: column; gap: 7px;
    padding-left: 14px; border-left: 1px solid var(--color-rule-2);
    transition: border-color .2s;
  }
  .agent:hover { border-left-color: var(--color-agents); }
  .agent h4 { font-size: 0.93rem; font-weight: 600; letter-spacing: -0.012em; }
  .agent p { font-size: 0.83rem; color: var(--color-mute); line-height: 1.58; }

  /* A single full-width statement instead of a two-column block: the page
     needed one moment that is not another grid of small grey text. */
  .owns {
    margin-top: 44px; padding-top: 30px; border-top: 1px solid var(--color-rule);
    display: flex; flex-direction: column; gap: 12px;
  }
  .owns .lbl {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-mute-2);
  }
  .owns p {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.9vw, 1.4rem);
    line-height: 1.45; letter-spacing: -0.015em;
    color: var(--color-bone); max-width: 30ch;
  }
</style>
