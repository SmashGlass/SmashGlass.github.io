---
import AgentConsole from './AgentConsole.tsx';
---
<section id="demos" class="section-rule">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Capabilities</p>
      <h2>Three things I get asked to build.</h2>
      <p>Switch the scenario to watch each one run end to end.</p>
      <p class="badge-row"><span class="note-badge">Illustrative demonstration &mdash; not client work</span></p>
    </div>
    <AgentConsole uid="demos" minHeight={348} client:visible />
  </div>
</section>

<style>
  .badge-row { margin-top: 18px; }
</style>
