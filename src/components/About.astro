---
/**
 * Deliberately short. Everything this section used to argue in prose — fixed
 * price, no agency, AI speed vs human judgement — is already stated once each
 * in the strip, the process section, and Experience. Repeating it here is what
 * made the page read as wordy.
 *
 * Laid out as a full-width list rather than the prose-left / list-right pattern
 * the other sections use, so the page stops having the same shape seven times.
 */
const values = [
  ['01', 'Executive-level technical judgment', 'Architecture calls made by someone who has owned the outcome.'],
  ['02', 'Hands-on delivery', 'The engineer who scopes your project is the one who writes it.'],
  ['03', 'Production engineering', 'Systems that run unattended and recover from failure.'],
  ['04', 'AI agent architecture', 'Tool design, approval gates, evals, run observability.'],
  ['05', 'Reliability and security', 'Test coverage and a security pass are in scope, not an upsell.'],
  ['06', 'Direct collaboration', 'One channel. Straight answers about what is hard.'],
];
---
<section id="about" class="section-rule">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Why SmashGlass</p>
      <h2>A studio built around senior judgement.</h2>
      <p>No bench, no junior team, and no account layer between you and the people writing your software.</p>
    </div>

    <dl class="vals">
      {values.map(([i, t, s]) => (
        <div class="val">
          <span class="i">{i}</span>
          <div>
            <dt class="t">{t}</dt>
            <dd class="s">{s}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .vals {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0 clamp(30px, 5vw, 64px);
    margin: 0; border-top: 1px solid var(--color-rule);
  }
  @media (max-width: 720px) { .vals { grid-template-columns: 1fr; } }

  .val {
    display: grid; grid-template-columns: 26px 1fr; gap: 14px;
    padding: 16px 0; border-bottom: 1px solid var(--color-rule); align-items: start;
  }
  .val .i { font-family: var(--font-mono); font-size: 0.64rem; color: var(--color-mute-2); padding-top: 2px; }
  .val .t { font-family: var(--font-display); font-size: 0.93rem; color: var(--color-bone); font-weight: 500; }
  .val .s { font-size: 0.83rem; color: var(--color-mute); line-height: 1.5; margin: 3px 0 0; }
</style>
