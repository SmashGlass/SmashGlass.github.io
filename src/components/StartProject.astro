---
/**
 * Form posts to a third-party endpoint (Formspree / Basin) so the site stays
 * fully static on GitHub Pages. Set PUBLIC_FORM_ENDPOINT at build time; with no
 * endpoint configured the form degrades to a mailto link rather than silently
 * dropping submissions.
 */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL ?? '';
---
<section class="contact" id="start">
  <div class="wrap ct-grid">
    <div>
      <p class="eyebrow">Start a project</p>
      <h2>Let's build something intelligent.</h2>
      <p class="intro">
        Tell me what's slow, breaking, or not getting done. You'll get a straight answer about
        whether it's worth building and roughly what it costs &mdash; usually within a day.
      </p>
      <div class="alt">
        {bookingUrl && (
          <a href={bookingUrl}>
            <span class="k mono">CALL</span> Book a 20-minute discovery call
            <span aria-hidden="true">&rarr;</span>
          </a>
        )}
        <a href="mailto:info@smashglass.com"><span class="k mono">EMAIL</span> info@smashglass.com</a>
        <a href="tel:+15127979101"><span class="k mono">PHONE</span> +1 (512) 797-9101</a>
      </div>
    </div>

    <form
      id="inq"
      method="POST"
      action={endpoint || 'mailto:info@smashglass.com'}
      data-configured={endpoint ? 'true' : 'false'}
    >
      <div class="fld">
        <label for="f-type">What kind of project</label>
        <select id="f-type" name="project_type">
          <option>AI agent development</option>
          <option>Business process automation</option>
          <option>Custom software or integration</option>
          <option>Legacy modernization / architecture review</option>
          <option>Not sure yet</option>
        </select>
      </div>

      <div class="fld">
        <label for="f-prob">What's the problem</label>
        <textarea
          id="f-prob" name="problem" required
          placeholder="The part of your business this is slowing down, and what you've tried so far."
        ></textarea>
        <span class="hint">Plain English is fine. Technical detail is optional.</span>
      </div>

      <div class="two">
        <div class="fld">
          <label for="f-budget">Budget range</label>
          <select id="f-budget" name="budget">
            <option>$1,500 – $5,000</option>
            <option>$5,000 – $15,000</option>
            <option>$15,000+</option>
            <option>Need help sizing it</option>
          </select>
        </div>
        <div class="fld">
          <label for="f-how">Preferred contact</label>
          <select id="f-how" name="contact_preference">
            <option>Email</option><option>Phone call</option><option>Video call</option>
          </select>
        </div>
      </div>

      <div class="fld">
        <label for="f-email">Where to reach you</label>
        <input id="f-email" name="email" type="email" required placeholder="you@company.com" />
      </div>

      <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn btn-pri submit" type="submit">
        Send project inquiry <span class="ar">&rarr;</span>
      </button>

      <p class="status" id="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact { background: linear-gradient(180deg, var(--color-ink) 0%, var(--color-ink-2) 100%); }
  .ct-grid {
    display: grid; grid-template-columns: 1fr 1.1fr;
    gap: clamp(34px, 5vw, 66px); align-items: start;
  }
  @media (max-width: 900px) { .ct-grid { grid-template-columns: 1fr; gap: 36px; } }

  .ct-grid h2 {
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    letter-spacing: -0.015em; line-height: 1.05; margin-bottom: 18px;
  }
  .intro { color: var(--color-mute); line-height: 1.65; max-width: 42ch; }

  .alt {
    margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--color-rule);
    display: flex; flex-direction: column; gap: 12px;
  }
  .alt a {
    font-size: 0.88rem; color: var(--color-bone); text-decoration: none;
    display: inline-flex; gap: 9px; align-items: center;
  }
  .alt a:hover { color: var(--color-agents); }
  .alt .k {
    font-family: var(--font-mono); font-size: 0.62rem; color: var(--color-mute-2);
    letter-spacing: 0.1em; min-width: 52px;
  }

  form {
    display: flex; flex-direction: column; gap: 16px;
    background: var(--color-graphite); border: 1px solid var(--color-rule-2);
    border-radius: 5px; padding: clamp(22px, 3vw, 30px);
  }
  .fld { display: flex; flex-direction: column; gap: 7px; }
  .fld label {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--color-mute-2);
  }
  .fld input, .fld select, .fld textarea {
    background: var(--color-ink); border: 1px solid var(--color-rule-2); border-radius: 3px;
    color: var(--color-bone); padding: 11px 12px;
    font-family: var(--font-body); font-size: 0.88rem; width: 100%;
    transition: border-color .16s;
  }
  .fld textarea { resize: vertical; min-height: 88px; line-height: 1.55; }
  .fld input:focus, .fld select:focus, .fld textarea:focus { border-color: var(--color-agents); outline: none; }
  .fld .hint { font-size: 0.74rem; color: var(--color-mute-2); }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 520px) { .two { grid-template-columns: 1fr; } }

  .hp { position: absolute; left: -9999px; }
  .submit { justify-content: center; }

  .status { font-size: 0.84rem; line-height: 1.5; display: none; }
  .status.show { display: block; }
  .status.ok { color: #5FDDB8; }
  .status.err { color: var(--color-modernize); }
</style>

<script>
  const form = document.getElementById('inq') as HTMLFormElement | null;
  const status = document.getElementById('status');
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      if (form.dataset.configured !== 'true') return; // let mailto fallback proceed
      e.preventDefault();

      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      status.className = 'status show';
      status.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.className = 'status show ok';
        status.textContent = "Thanks — I'll come back to you within a day.";
      } catch {
        status.className = 'status show err';
        status.innerHTML =
          'That didn\'t send. Email <a href="mailto:info@smashglass.com">info@smashglass.com</a> and I\'ll pick it up there.';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
